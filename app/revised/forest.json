      "intro": "\u041b\u0430\u0434\u0430 \u0433\u043e\u0442\u0443\u0454 \u0432\u0435\u0447\u0456\u0440\u043d\u044e \u043f\u0440\u043e\u0433\u0443\u043b\u044f\u043d\u043a\u0443 \u0441\u0442\u0435\u0436\u043a\u043e\u044e \u0437 \u043f\u0430\u043f\u0435\u0440\u043e\u0432\u0438\u043c\u0438 \u0433\u0440\u0438\u0431\u0430\u043c\u0438. \u041f\u0456\u0434 \u0447\u0430\u0441 \u0434\u0435\u043d\u043d\u043e\u0457 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u043b\u0456\u0445\u0442\u0430\u0440\u0456\u0432 \u043d\u0435 \u0437\u0430\u0441\u0432\u0456\u0442\u0438\u043b\u0430\u0441\u044f. \u0423\u0441\u0456 \u0447\u0435\u043a\u0430\u044e\u0442\u044c \u0431\u0456\u043b\u044f \u0432\u0445\u043e\u0434\u0443, \u043f\u043e\u043a\u0438 \u043c\u0430\u0439\u0441\u0442\u0435\u0440 \u0406\u043b\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0454 \u043e\u0441\u0432\u0456\u0442\u043b\u0435\u043d\u043d\u044f. \u0414\u043e\u043f\u043e\u043c\u043e\u0436\u0438 \u0437\u043d\u0430\u0439\u0442\u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u0443 \u0439 \u0441\u043f\u043b\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0433\u0443\u043b\u044f\u043d\u043a\u0443.",
      "ending": "\u041f\u0440\u0438\u0447\u0438\u043d\u0443 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e: \u0442\u0440\u0435\u0442\u0456\u0439 \u0431\u043b\u043e\u043a \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u043b\u0438 \u0437\u0430\u0440\u0430\u043d\u043e, \u0456 \u0432\u0456\u043d \u0440\u043e\u0437\u0440\u044f\u0434\u0438\u0432\u0441\u044f \u0449\u0435 \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438. \u0406\u043b\u043b\u044f \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0432 \u043e\u0431\u0440\u0430\u043d\u0438\u0439 \u0437\u0430\u043f\u0430\u0441\u043d\u0438\u0439 \u0431\u043b\u043e\u043a \u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0432 \u0443\u0441\u0456 \u043b\u0456\u0445\u0442\u0430\u0440\u0456. \u0412\u0435\u0447\u0456\u0440\u043d\u044f \u043f\u0440\u043e\u0433\u0443\u043b\u044f\u043d\u043a\u0430 \u0442\u0440\u0438\u0432\u0430\u0442\u0438\u043c\u0435 \u0433\u043e\u0434\u0438\u043d\u0443, \u0430 \u0441\u0432\u0456\u0442\u043b\u0430 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044c \u0449\u0435 \u043d\u0430 15 \u0445\u0432\u0438\u043b\u0438\u043d. \u0414\u0456\u0442\u0438 \u0432\u0438\u0440\u0443\u0448\u0430\u044e\u0442\u044c \u0440\u0430\u0437\u043e\u043c \u0456\u0437 \u041b\u0430\u0434\u043e\u044e.",
      "question": "\u0427\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0430 \u043b\u0456\u0445\u0442\u0430\u0440\u044f \u0456\u0437 \u0437\u0430\u043f\u0430\u0441\u043d\u0438\u043c \u0431\u043b\u043e\u043a\u043e\u043c \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043b\u0430 \u0437\u0432\u0443\u0437\u0438\u0442\u0438 \u043f\u043e\u0448\u0443\u043a \u043f\u0440\u0438\u0447\u0438\u043d\u0438?",
      "steps": [
        {
          "title": "\u0414\u0435 \u0437\u0430\u043a\u0456\u043d\u0447\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u0432\u0456\u0442\u043b\u043e?",
          "situation": "\u041b\u0430\u0434\u0430 \u0440\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u0454 \u043f\u043b\u0430\u043d \u0441\u0442\u0435\u0436\u043a\u0438. \u0414\u0456\u043b\u044f\u043d\u043a\u0438 \u0439\u0434\u0443\u0442\u044c \u043e\u0434\u043d\u0430 \u0437\u0430 \u043e\u0434\u043d\u043e\u044e, \u0430 \u043b\u0456\u0445\u0442\u0430\u0440\u0456 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u043b\u0438 \u0432\u0456\u0434 \u0432\u0445\u043e\u0434\u0443.",
          "evidence": [
