  "locales": {
    "ru": {
      "title": "\u041b\u0435\u0441\u043d\u044b\u0435 \u0444\u043e\u043d\u0430\u0440\u0438",
      "intro": "\u041b\u0430\u0434\u0430 \u0433\u043e\u0442\u043e\u0432\u0438\u0442 \u0432\u0435\u0447\u0435\u0440\u043d\u044e\u044e \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0443 \u043f\u043e \u0442\u0440\u043e\u043f\u0435 \u0441 \u0431\u0443\u043c\u0430\u0436\u043d\u044b\u043c\u0438 \u0433\u0440\u0438\u0431\u0430\u043c\u0438. \u0412\u043e \u0432\u0440\u0435\u043c\u044f \u0434\u043d\u0435\u0432\u043d\u043e\u0439 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0447\u0430\u0441\u0442\u044c \u0444\u043e\u043d\u0430\u0440\u0435\u0439 \u043d\u0435 \u0437\u0430\u0433\u043e\u0440\u0435\u043b\u0430\u0441\u044c. \u0412\u0441\u0435 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u0443 \u0432\u0445\u043e\u0434\u0430, \u043f\u043e\u043a\u0430 \u043c\u0430\u0441\u0442\u0435\u0440 \u0418\u043b\u044c\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435. \u041f\u043e\u043c\u043e\u0433\u0438 \u043d\u0430\u0439\u0442\u0438 \u043f\u0440\u0438\u0447\u0438\u043d\u0443 \u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u043f\u043b\u0430\u043d \u043f\u0440\u043e\u0433\u0443\u043b\u043a\u0438.",
      "ending": "\u041f\u0440\u0438\u0447\u0438\u043d\u0430 \u043d\u0430\u0439\u0434\u0435\u043d\u0430: \u0442\u0440\u0435\u0442\u0438\u0439 \u0431\u043b\u043e\u043a \u0432\u043a\u043b\u044e\u0447\u0438\u043b\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0440\u0430\u043d\u043e, \u0438 \u0435\u0433\u043e \u0437\u0430\u0440\u044f\u0434 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0441\u044f \u0434\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438. \u0418\u043b\u044c\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0437\u0430\u043f\u0430\u0441\u043d\u043e\u0439 \u0431\u043b\u043e\u043a \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043b \u0432\u0441\u0435 \u0444\u043e\u043d\u0430\u0440\u0438. \u041d\u0430 \u0432\u0435\u0447\u0435\u0440 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d \u0447\u0430\u0441\u043e\u0432\u043e\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u0441 \u0437\u0430\u043f\u0430\u0441\u043e\u043c \u0440\u0430\u0431\u043e\u0442\u044b 15 \u043c\u0438\u043d\u0443\u0442. \u0414\u0435\u0442\u0438 \u0438\u0434\u0443\u0442 \u043f\u043e \u043d\u0435\u043c\u0443 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u041b\u0430\u0434\u043e\u0439.",
      "question": "\u041f\u043e\u0447\u0435\u043c\u0443 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0439 \u043d\u0430 \u0437\u0430\u043f\u0430\u0441\u043d\u043e\u043c \u0431\u043b\u043e\u043a\u0435 \u0444\u043e\u043d\u0430\u0440\u044c \u043f\u043e\u043c\u043e\u0433 \u0441\u0443\u0437\u0438\u0442\u044c \u043f\u043e\u0438\u0441\u043a \u043f\u0440\u0438\u0447\u0438\u043d\u044b?",
      "steps": [
        {
          "title": "\u0413\u0434\u0435 \u043e\u0431\u0440\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u0432\u0435\u0442?",
          "situation": "\u041b\u0430\u0434\u0430 \u0440\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u043f\u043b\u0430\u043d \u0442\u0440\u043e\u043f\u044b. \u0423\u0447\u0430\u0441\u0442\u043a\u0438 \u0438\u0434\u0443\u0442 \u043f\u043e\u0434\u0440\u044f\u0434, \u0438 \u0444\u043e\u043d\u0430\u0440\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u043b\u0438 \u043e\u0442 \u0432\u0445\u043e\u0434\u0430.",
