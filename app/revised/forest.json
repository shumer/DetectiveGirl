          "outcome": "\u041e\u0431\u0438\u0434\u0432\u0456 \u0442\u0435\u043c\u043d\u0456 \u0434\u0456\u043b\u044f\u043d\u043a\u0438 \u0436\u0438\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u0432\u0456\u0434 \u0431\u043b\u043e\u043a\u0430 3. \u0406\u043b\u043b\u044f \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0439\u043e\u0433\u043e \u0431\u0456\u043b\u044f \u041a\u0440\u0443\u0433\u043b\u043e\u0457 \u0433\u0430\u043b\u044f\u0432\u0438\u043d\u0438.",
          "next": "\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0442\u0440\u0435\u0442\u0456\u0439 \u0431\u043b\u043e\u043a",
          "hints": [
