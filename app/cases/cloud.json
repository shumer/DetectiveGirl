  "locales": {
    "ru": {
      "title": "\u041f\u043e\u0441\u044b\u043b\u043a\u0430 \u0434\u043b\u044f \u043e\u0431\u043b\u0430\u0447\u043d\u043e\u0433\u043e \u043e\u0441\u0442\u0440\u043e\u0432\u0430",
      "intro": "\u041d\u0430 \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u0435 \u043e\u0441\u0442\u0430\u043b\u0430\u0441\u044c \u043a\u043e\u0440\u043e\u0431\u043a\u0430 \u0441 \u0440\u0430\u0437\u043c\u043e\u043a\u0448\u0438\u043c \u0430\u0434\u0440\u0435\u0441\u043e\u043c. \u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442: \u0432\u043d\u0443\u0442\u0440\u0438 \u043e\u0434\u0438\u043d \u0438\u0437 \u0442\u0440\u0451\u0445 \u043d\u0430\u0431\u043e\u0440\u043e\u0432 \u0441\u0435\u0433\u043e\u0434\u043d\u044f\u0448\u043d\u0435\u0433\u043e \u0436\u0443\u0440\u043d\u0430\u043b\u0430. \u041f\u043e\u0447\u0442\u0430\u043b\u044c\u043e\u043d \u043f\u0440\u043e\u0441\u0438\u0442 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043d\u0430\u043a\u043b\u0430\u0434\u043d\u0443\u044e \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0434\u0435\u0442\u0430\u043b\u0438 \u0434\u043e \u0441\u0431\u043e\u0440\u043a\u0438 \u0444\u043b\u044e\u0433\u0435\u0440\u0430. \u0423 \u043d\u0430\u0441 \u0435\u0441\u0442\u044c \u0432\u0435\u0441\u044b, \u0436\u0443\u0440\u043d\u0430\u043b \u0438 \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0435.",
      "ending": "\u041f\u043e\u0447\u0442\u0430\u043b\u044c\u043e\u043d \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u044f\u0435\u0442 \u043d\u0430\u043a\u043b\u0430\u0434\u043d\u0443\u044e: \u043d\u0430\u0431\u043e\u0440 \u0411, 54 \u0434\u0435\u0442\u0430\u043b\u0438, \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0430\u044f \u0443 \u0421\u0438\u043d\u0435\u0439 \u0431\u0430\u0448\u043d\u0438, \u043a\u0443\u0440\u044c\u0435\u0440 \u0411. \u041f\u043e\u0437\u0436\u0435 \u043c\u0430\u0441\u0442\u0435\u0440 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u0432 12:05. \u041e\u0448\u0438\u0431\u043a\u0443 \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u043b\u0438 \u0434\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438, \u0438 \u0441\u0431\u043e\u0440\u043a\u0430 \u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044c \u0432\u043e\u0432\u0440\u0435\u043c\u044f.",
      "question": "\u041f\u043e\u0447\u0435\u043c\u0443 \u0441\u0430\u043c\u044b\u0439 \u0440\u0430\u043d\u043d\u0438\u0439 \u043a\u0443\u0440\u044c\u0435\u0440 \u043d\u0435 \u043f\u043e\u0434\u043e\u0448\u0451\u043b?",
      "steps": [
        {
          "title": "\u041e\u043f\u043e\u0437\u043d\u0430\u0442\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435",
          "text": "\u041f\u043e\u0441\u044b\u043b\u043a\u0430 \u0435\u0449\u0451 \u043d\u0430 \u043f\u043e\u0447\u0442\u0435. \u041e\u043d\u0430 \u0432\u0435\u0441\u0438\u0442 1 \u043a\u0433 250 \u0433, \u043f\u0443\u0441\u0442\u0430\u044f \u043a\u043e\u0440\u043e\u0431\u043a\u0430 150 \u0433, \u0437\u0430\u0449\u0438\u0442\u043d\u0430\u044f \u0431\u0443\u043c\u0430\u0433\u0430 100 \u0433. \u0412 \u0436\u0443\u0440\u043d\u0430\u043b\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u0430 \u043c\u0430\u0441\u0441\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u0435\u0442\u0430\u043b\u0435\u0439: \u043d\u0430\u0431\u043e\u0440 \u0410 900 \u0433, \u0411 1000 \u0433, \u0412 1100 \u0433. \u041a\u0430\u043a\u043e\u0439 \u043d\u0430\u0431\u043e\u0440 \u0432\u043d\u0443\u0442\u0440\u0438?",
          "options": [
