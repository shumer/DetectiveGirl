        {
          "title": "\u0421\u043e\u0431\u0440\u0430\u0442\u044c \u043f\u043e\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c",
          "text": "\u0421\u0432\u0435\u0442 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d. \u041f\u043e \u043c\u043e\u043d\u0442\u0430\u0436\u043d\u043e\u043c\u0443 \u043b\u0438\u0441\u0442\u0443 \u0441\u0446\u0435\u043d\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e \u0441\u0432\u0435\u0442\u043b\u0435\u0442\u044c. \u041d\u0430 \u0441\u043b\u0430\u0439\u0434\u0430\u0445 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435 \u043a\u0440\u0443\u0433\u0438: \u041b\u0443\u043d\u0430 \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0430 \u043d\u0430 3/8, \u041b\u0438\u0441\u0430 \u043d\u0430 1/8, \u041a\u043e\u0440\u0430\u0431\u043b\u044c \u043d\u0430 5/8. \u0412\u044b\u0431\u0435\u0440\u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043e\u0442 \u043c\u0435\u043d\u044c\u0448\u0435\u0439 \u043e\u0441\u0432\u0435\u0449\u0451\u043d\u043d\u043e\u0439 \u0434\u043e\u043b\u0438 \u043a \u0431\u043e\u043b\u044c\u0448\u0435\u0439.",
