  "locales": {
    "ru": {
      "title": "\u041c\u0443\u0437\u0435\u0439 \u043f\u0435\u0440\u0435\u043f\u0443\u0442\u0430\u043d\u043d\u044b\u0445 \u0442\u0435\u043d\u0435\u0439",
      "intro": "\u041f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u043c\u0443\u0437\u0435\u0439 \u0442\u0435\u043d\u0435\u0439 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u0447\u0430\u0442\u044c \u043f\u043e\u043a\u0430\u0437: \u043b\u0430\u043c\u043f\u044b \u0432\u044b\u043d\u0443\u043b\u0438, \u0441\u043b\u0430\u0439\u0434\u044b \u043f\u0435\u0440\u0435\u043c\u0435\u0448\u0430\u043b\u0438, \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0440 \u0441\u0442\u043e\u0438\u0442 \u0443 \u0447\u0443\u0436\u043e\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430. \u0421\u043c\u043e\u0442\u0440\u0438\u0442\u0435\u043b\u044c \u0434\u0430\u0451\u0442 \u043c\u043e\u043d\u0442\u0430\u0436\u043d\u044b\u0439 \u043b\u0438\u0441\u0442. \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043c \u0441\u0432\u0435\u0442, \u043a\u0430\u0434\u0440\u044b, \u044d\u043a\u0440\u0430\u043d \u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u043e\u0432.",
      "ending": "\u041f\u0440\u043e\u0431\u043d\u044b\u0439 \u043f\u043e\u043a\u0430\u0437 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442 \u0431\u0435\u0437 \u0441\u0431\u043e\u0435\u0432. \u041f\u0440\u0438\u0447\u0438\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432 \u043f\u0435\u0440\u0435\u043f\u0443\u0442\u0430\u043d\u043d\u043e\u0439 \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0435 \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0435\u0437\u0434\u0435. \u0421\u043c\u043e\u0442\u0440\u0438\u0442\u0435\u043b\u044c \u043f\u043e\u0434\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u043a\u043e\u0440\u043e\u0431\u043a\u0443 \u044d\u043a\u0440\u0430\u043d\u0430 \u0411 \u0438 \u043a\u043b\u0430\u0434\u0451\u0442 \u0442\u0443\u0434\u0430 \u043c\u043e\u043d\u0442\u0430\u0436\u043d\u044b\u0439 \u043b\u0438\u0441\u0442.",
      "question": "\u0427\u0435\u043c \u043f\u0435\u0440\u0438\u043c\u0435\u0442\u0440 \u044d\u043a\u0440\u0430\u043d\u0430 \u043e\u0442\u043b\u0438\u0447\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u0435\u0433\u043e \u043f\u043b\u043e\u0449\u0430\u0434\u0438?",
      "steps": [
        {
          "title": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0441\u0432\u0435\u0442",
          "text": "\u041d\u0430 \u043f\u0430\u043d\u0435\u043b\u0438 24 \u0433\u043d\u0435\u0437\u0434\u0430. \u041f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0432\u043e\u0437\u043a\u0438 3/8 \u0433\u043d\u0451\u0437\u0434 \u043f\u0443\u0441\u0442\u044b\u0435 \u0438 \u043e\u0442\u043c\u0435\u0447\u0435\u043d\u044b \u0437\u0432\u0451\u0437\u0434\u043e\u0447\u043a\u0430\u043c\u0438 \u043d\u0430 \u0441\u0445\u0435\u043c\u0435. \u0421\u043a\u043e\u043b\u044c\u043a\u043e \u043b\u0430\u043c\u043f \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u0442\u044c \u0443 \u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435\u043b\u044f, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u043f\u0443\u0441\u0442\u044b\u0435 \u0433\u043d\u0451\u0437\u0434\u0430?",
          "options": [
            "9",
            "8",
            "3"
          ],
          "answer": 0,
          "explanation": "24 : 8 \u00d7 3 = 9. \u041f\u043e\u0441\u043b\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0434\u0435\u0432\u044f\u0442\u0438 \u043b\u0430\u043c\u043f \u0441\u043b\u0430\u0439\u0434\u044b \u0441\u0442\u0430\u043d\u0443\u0442 \u0432\u0438\u0434\u043d\u044b.",
          "hints": [
            "\u041d\u0430\u0439\u0434\u0438 \u043e\u0434\u043d\u0443 \u0432\u043e\u0441\u044c\u043c\u0443\u044e \u0432\u0441\u0435\u0445 \u0433\u043d\u0451\u0437\u0434.",
            "24 : 8 = 3; \u043d\u0443\u0436\u043d\u044b \u0442\u0440\u0438 \u0442\u0430\u043a\u0438\u0435 \u0447\u0430\u0441\u0442\u0438.",
            "3 \u00d7 3 = 9 \u043b\u0430\u043c\u043f."
